<?xml version="1.0" encoding="UTF-8"?>
<!--
CorrectiveActionMapper.xml — 개선조치관리 sp_tbl_corrective_action_* 호출.

개발자: 박승우
일자: 2026-08-26
코멘트:
  1) 조회는 TABLE FUNCTION, 저장·삭제는 PostgreSQL PROCEDURE 를 호출한다
  2) 조회 resultType 은 DTO. snake 컬럼은 camel 로 맞춘다
  3) tsk/TaskMapper.xml 에서 옮겼다 — URL 이 /flow/ca 인데 패키지가 tsk 였다

PIPELINE[HB94] 개선조치관리 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.flow.ca.CorrectiveActionMapper">

    <!-- 기간·양식·작성자 조건 목록. 공백 조건은 SP 가 전체로 본다 -->
    <select id="selectCorrectiveActions" resultType="com.haccp.flow.ca.dto.CorrectiveRow">
        SELECT * FROM sp_tbl_corrective_action_r_000(#{coCd}, #{fromDt}, #{toDt}, #{tmplCd}, #{writer})
    </select>

    <!-- 신규·수정 저장. idx 가 null 이면 SP 가 신규로 본다 -->
    <update id="saveCorrectiveAction" statementType="CALLABLE">
        CALL sp_tbl_corrective_action_c_000(#{coCd}, #{idx}, CAST(#{payloadJson} AS jsonb), #{userId})
    </update>

    <!--
      삭제 차단 검사 — 완료(DONE)된 개선조치는 지울 수 없다.
      위반 첫 건만 돌아온다. 없으면 null 이라 삭제를 진행한다.
    -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT * FROM sp_tbl_corrective_action_delete_blocker_r_000(
            #{coCd, jdbcType=VARCHAR},
            <foreach collection="idxs" item="idx" open="ARRAY[" separator="," close="]::bigint[]">
                #{idx, jdbcType=BIGINT}
            </foreach>
        )
    </select>

    <!-- 삭제. 완료된 건은 SP 가 막는다 -->
    <update id="deleteCorrectiveAction" statementType="CALLABLE">
        CALL sp_tbl_corrective_action_d_000(#{coCd}, #{idx}, #{userId})
    </update>

</mapper>
