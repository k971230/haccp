<?xml version="1.0" encoding="UTF-8"?>
<!--
CommonCodeMapper.xml — 공통코드 관리 화면 SP 호출 매퍼.

개발자: 박승우
일자: 2026-08-12
코멘트:
  1) sp_common_code_management_* 만 호출한다 — 네이티브 SELECT/INSERT/UPDATE/DELETE 금지
  2) coCd는 JWT에서 온 테넌트 키이며 모든 SP의 첫 인자다
  3) 삭제 차단 조회는 idx 배열 하나로 한 번에 검사하고 첫 건만 받는다

PIPELINE[HB92] 공통코드 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.sys.commoncode.CommonCodeMapper">

    <!--
      대분류 목록 — sp_common_code_management_r_000
      SP는 로그인 회사 범위만 읽는다(표준코드 '0000' 병합 없음) — 표준분은 업체 생성 시 복제된 자기 행이다
      mainCd·codeNm은 헤더 부분검색어라 공백이면 전체가 나온다
    -->
    <select id="selectGroups" resultType="map">
        SELECT * FROM sp_common_code_management_r_000(
            #{coCd,   jdbcType=VARCHAR},
            #{mainCd, jdbcType=VARCHAR},
            #{codeNm, jdbcType=VARCHAR}
        )
    </select>

    <!--
      세부코드 목록 — sp_common_code_management_r_001
      mainCd는 정확 일치, sysYn은 시스템(Y·sys)/사용자(N·usr) 구분, useYn 공백이면 사용중지 코드까지 본다
    -->
    <select id="selectDetails" resultType="map">
        SELECT * FROM sp_common_code_management_r_001(
            #{coCd,   jdbcType=VARCHAR},
            #{mainCd, jdbcType=VARCHAR},
            #{sysYn,  jdbcType=VARCHAR},
            #{useYn,  jdbcType=VARCHAR}
        )
    </select>

    <!--
      세부코드 저장 — sp_common_code_management_c_000
      idx가 null일 때(= 신규 행) SP가 업무키 중복을 먼저 검사하고 INSERT 분기를 탄다
    -->
    <update id="save" statementType="CALLABLE">
        CALL sp_common_code_management_c_000(
            #{coCd,   jdbcType=VARCHAR},
            #{idx,    jdbcType=BIGINT},
            #{mainCd, jdbcType=VARCHAR},
            #{subCd,  jdbcType=VARCHAR},
            #{codeNm, jdbcType=VARCHAR},
            #{sortNo, jdbcType=INTEGER},
            #{ref1,   jdbcType=VARCHAR},
            #{ref2,   jdbcType=VARCHAR},
            #{useYn,  jdbcType=VARCHAR},
            #{userId, jdbcType=VARCHAR}
        )
    </update>

    <!--
      삭제 차단 조회 — sp_common_code_management_delete_blocker_r_000
      idxs를 bigint[]로 묶어 왕복 1회로 끝낸다. 차단 사유가 없으면 0행
    -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT ref_key, target
          FROM sp_common_code_management_delete_blocker_r_000(
              #{coCd, jdbcType=VARCHAR},
              ARRAY[<foreach collection="idxs" item="idx" separator=",">#{idx, jdbcType=BIGINT}</foreach>]::bigint[]
          )
         LIMIT 1
    </select>

    <!--
      세부코드 삭제 — sp_common_code_management_d_000
      Service가 assertDeletable을 두 번 통과시킨 뒤에만 호출한다
    -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_common_code_management_d_000(
            #{coCd, jdbcType=VARCHAR},
            #{idx,  jdbcType=BIGINT}
        )
    </update>

</mapper>
