<?xml version="1.0" encoding="UTF-8"?>
<!--
MenuMgmtMapper.xml — 메뉴 관리 화면 SP 호출 매퍼.

개발자: 박승우
일자: 2026-08-12
코멘트:
  1) sp_menu_management_* 만 호출한다 — 네이티브 SQL 금지
  2) 사이드바 트리는 sp_menu_nav_r_000이며 mapper/menu/MenuMapper.xml이 담당한다
  3) 삭제 차단 조회는 idx 배열 하나로 한 번에 검사하고 첫 건만 받는다

PIPELINE[HB92] 메뉴 관리 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.sys.code.menu.MenuMgmtMapper">

    <!--
      메뉴 관리 목록 — sp_menu_management_r_000
      권한 필터가 없는 관리자 조회이며 sort_no(대중소 인코딩) 순으로 내려온다
      좌측 트리가 전체 집합을 요구하므로 화면은 menuCd·menuNm·useYn을 공백으로 넘긴다
    -->
    <select id="selectRows" resultType="com.haccp.sys.code.menu.dto.MenuMgmtRow">
        SELECT * FROM sp_menu_management_r_000(
            #{coCd,   jdbcType=VARCHAR},
            #{menuCd, jdbcType=VARCHAR},
            #{menuNm, jdbcType=VARCHAR},
            #{useYn,  jdbcType=VARCHAR}
        )
    </select>

    <!--
      메뉴 저장 — sp_menu_management_c_000
      useYn을 N으로 내리면 SP가 재귀 CTE로 자손 메뉴까지 N으로 전파한다
    -->
    <update id="save" statementType="CALLABLE">
        CALL sp_menu_management_c_000(
            #{coCd,    jdbcType=VARCHAR},
            #{idx,     jdbcType=BIGINT},
            #{menuCd,  jdbcType=VARCHAR},
            #{menuNm,  jdbcType=VARCHAR},
            #{hMenuCd, jdbcType=VARCHAR},
            #{scrnCd,  jdbcType=VARCHAR},
            #{sortNo,  jdbcType=INTEGER},
            #{useYn,   jdbcType=VARCHAR},
            #{userId,  jdbcType=VARCHAR}
        )
    </update>

    <!--
      삭제 차단 조회 — sp_menu_management_delete_blocker_r_000
      하위 메뉴를 가진 첫 행만 돌려받아 사용자 문구로 바꾼다
    -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT ref_key, target
          FROM sp_menu_management_delete_blocker_r_000(
              #{coCd, jdbcType=VARCHAR},
              ARRAY[<foreach collection="idxs" item="idx" separator=",">#{idx, jdbcType=BIGINT}</foreach>]::bigint[]
          )
         LIMIT 1
    </select>

    <!--
      메뉴 삭제 — sp_menu_management_d_000
      SP가 하위 메뉴 존재를 다시 확인하므로 앱·DB 두 겹으로 막힌다
    -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_menu_management_d_000(
            #{coCd, jdbcType=VARCHAR},
            #{idx,  jdbcType=BIGINT}
        )
    </update>

</mapper>
