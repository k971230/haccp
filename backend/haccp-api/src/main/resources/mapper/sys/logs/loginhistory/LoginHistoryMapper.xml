<?xml version="1.0" encoding="UTF-8"?>
<!--
LoginHistoryMapper.xml — 로그인 이력 화면 SP 호출 매퍼.

개발자: 박승우
일자: 2026-08-12
코멘트:
  1) sp_login_history_r_000 조회 1건만 담당한다 — 네이티브 SQL 금지
  2) 기간은 Controller가 YYYYMMDD로 정규화한 값만 들어온다
  3) 종료일은 SP가 그날 24시 직전까지 포함한다

PIPELINE[HB92] 로그인 이력 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.sys.logs.loginhistory.LoginHistoryMapper">

    <!--
      로그인 이력 목록 — sp_login_history_r_000
      userId는 좌측 사용자 트리 선택값, resultCd는 성공·실패·잠금 필터이며 공백이면 전체다
    -->
    <select id="selectRows" resultType="com.haccp.sys.logs.loginhistory.dto.LoginHistoryRow">
        SELECT * FROM sp_login_history_r_000(
            #{coCd,     jdbcType=VARCHAR},
            #{fromDt,   jdbcType=VARCHAR},
            #{toDt,     jdbcType=VARCHAR},
            #{userId,   jdbcType=VARCHAR},
            #{resultCd, jdbcType=VARCHAR}
        )
    </select>

</mapper>
