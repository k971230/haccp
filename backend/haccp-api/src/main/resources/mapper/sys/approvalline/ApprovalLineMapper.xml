<?xml version="1.0" encoding="UTF-8"?>
<!--
ApprovalLineMapper.xml — 결재선 관리 SP 호출.

개발자: 박승우
일자: 2026-08-19
코멘트:
  1) sp_tbl_approval_line_* 만 호출한다 — 테이블 직접 DML 금지
  2) JWT coCd를 첫 인자로 넘겨 테넌트를 고정한다
  3) 왼쪽 삭제가 validate-delete·delete 로 같은 SP를 쓴다

PIPELINE[HB89] 결재선 관리 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.sys.approvalline.ApprovalLineMapper">

    <!-- 결재선 헤더와 단계 배열 JSON 목록 -->
    <select id="selectApprovalLines" resultType="string">
        SELECT payload::text FROM sp_tbl_approval_line_r_000(
            #{coCd, jdbcType=VARCHAR}
        )
    </select>

    <!-- 결재선 저장 — 헤더와 단계 배열을 동일 트랜잭션에서 교체 -->
    <update id="saveApprovalLine" statementType="CALLABLE">
        CALL sp_tbl_approval_line_c_000(
            #{coCd, jdbcType=VARCHAR},
            CAST(#{payload, jdbcType=VARCHAR} AS jsonb),
            #{userId, jdbcType=VARCHAR}
        )
    </update>

    <!-- 결재선 삭제 사전 차단 — 양식·문서 참조 중 첫 사유 -->
    <select id="selectApprovalLineBlocker" resultType="map">
        SELECT * FROM sp_tbl_approval_line_delete_blocker_r_000(
            #{coCd, jdbcType=VARCHAR},
            #{apprLineCd, jdbcType=VARCHAR}
        )
    </select>

    <!-- 결재선 삭제 — SP가 참조를 다시 확인한다 -->
    <update id="deleteApprovalLine" statementType="CALLABLE">
        CALL sp_tbl_approval_line_d_000(
            #{coCd, jdbcType=VARCHAR},
            #{apprLineCd, jdbcType=VARCHAR},
            #{userId, jdbcType=VARCHAR}
        )
    </update>
</mapper>
