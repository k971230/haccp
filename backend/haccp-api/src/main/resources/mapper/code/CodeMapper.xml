<?xml version="1.0" encoding="UTF-8"?>
<!--
CodeMapper.xml — 공통코드 조회 SP 호출 매퍼.

개발자: 박승우
일자: 2026-08-05
코멘트:
  1) 조회 1건만 담당한다 — 회사코드 완전 격리이며 SP가 로그인 회사 범위만 읽는다
  2) mainCd·useYn은 부분 일치 조건이라 공백을 넘기면 전체가 나온다(조건 없음과 같다)
  3) 표준코드는 업체 생성 시 복제되므로 조회에서 '0000'을 병합하지 않는다 — 앱에서도 병합하지 않는다

PIPELINE[HB36] MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.code.CodeMapper">

    <!--
      공통코드 목록 조회 — sp_common_code_management_r_001 (공통코드 관리 화면과 공유하는 화면명 SP)
      coCd는 JWT 회사코드이며, SP는 이 회사 범위만 읽는다(표준코드 '0000' 병합 없음)
      mainCd는 대분류 정확 일치이며 공백이면 전체 그룹이다 — 콤보는 항상 정확한 대분류를 넘긴다
      sysYn은 시스템/사용자 구분 필터로, 콤보는 구분 없이 전부 필요하므로 빈 문자열을 고정 전달한다
      useYn은 사용여부 필터로 공백이면 Y·N 모두 포함한다
      업체 코드 자체가 유일하므로 중복 제거 절이 없다 — 표준 문구 수정은 업체 자신의 행을 고치는 것이다
      결과: 대분류 → 정렬순서 → 세부코드 순으로 정렬된 CodeRow 목록
    -->
    <select id="selectCodes" resultType="com.haccp.code.dto.CodeRow">
        SELECT * FROM sp_common_code_management_r_001(
            #{coCd,   mode=IN, jdbcType=VARCHAR},
            #{mainCd, mode=IN, jdbcType=VARCHAR},
            '',
            #{useYn,  mode=IN, jdbcType=VARCHAR}
        )
    </select>

</mapper>
