<?xml version="1.0" encoding="UTF-8"?>
<!--
CcpLogDraftMapper.xml — CCP 포장·가열 작성 SP.

개발자: 박승우
일자: 2026-08-24
코멘트:
  1) 데이터는 기존 tbl_ccp_generic_monitor(+_row·_cell). 저장·상세는 기존 SP 를 그대로 쓴다
  2) 목록은 화면 전용 sp_ccp_log_r_000 — 양식군 접두(tml_ccp_pkg_ · tml_ccp_htg_)로 가른다
  3) 양식 목록·항목만 계열 SP 가 달라 choose 로 가른다

PIPELINE[HB139] CCP 모니터링 작성 XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.draft.ccpmonitoring.CcpLogDraftMapper">

    <!--
      작성 가능 양식 — 양식관리 좌측과 같은 SP.
      use_yn 은 tbl_company_template.use_yn 이라 「사용여부 = 예」와 같은 값이다.
      표준 예시 *_000 은 가상행이라 코드로 한 번 더 뺀다.
    -->
    <select id="selectForms" resultType="com.haccp.draft.dto.DraftFormRow">
        SELECT v.tmpl_cd, v.ver_nm, v.ver_no, v.use_yn, v.ins_dt
          FROM
        <choose>
            <when test="family == 'htg'">
                sp_tbl_tml_ccp_htg_ver_r_000(#{coCd}, #{stdTmplCd}, '', '') v
            </when>
            <otherwise>
                sp_tbl_tml_ccp_pkg_ver_r_000(#{coCd}, #{stdTmplCd}, '', '') v
            </otherwise>
        </choose>
         WHERE upper(v.use_yn) = 'Y'
           AND v.ver_no &gt; 0
           AND v.tmpl_cd &lt;&gt; #{stdTmplCd}
         ORDER BY v.tmpl_cd
    </select>

    <!-- 양식 항목 — 한계기준·주기·방법·개선조치. 지면 상단이 쓴다 -->
    <select id="selectFormItems" resultType="map">
        SELECT * FROM
        <choose>
            <when test="family == 'htg'">
                sp_tbl_tml_ccp_htg_ver_item_r_000(#{coCd}, #{tmplCd}, #{verNo})
            </when>
            <otherwise>
                sp_tbl_tml_ccp_pkg_ver_item_r_000(#{coCd}, #{tmplCd}, #{verNo})
            </otherwise>
        </choose>
    </select>

    <!-- 좌측 작성 목록 — 결재 여부는 DOC_STATUS 파생이라 화면이 거른다 -->
    <select id="selectList" resultType="com.haccp.draft.dto.DraftListRow">
        SELECT * FROM sp_ccp_log_r_000(
            #{coCd}, #{tmplPfx}, #{tmplCd}, #{tmplNm}, #{fromDt}, #{toDt}, #{writerId}, #{writerNm}
        )
    </select>

    <!-- 상세 — 헤더 + rows_json(기록행·셀). 124에서 phaseCd 가 rows_json 에 들어간다 -->
    <select id="selectDetail" resultType="map">
        SELECT * FROM sp_tbl_ccp_generic_monitor_r_000(#{coCd}, #{docIdx})
    </select>

    <!--
      저장 — 기존 공통 CCP SP. ccp_cd·diary_no·limit_item_kind 는 이 화면이 안 쓴다.
      mng_nm 에 관리자·점검자명을 넣는다.
    -->
    <select id="save" resultType="long">
        SELECT sp_tbl_ccp_generic_monitor_c_000(
            #{coCd}, #{docIdx}, #{baseDt}, #{tmplCd},
            '', '', '', '', #{mngNm},
            CAST(#{rowsJson} AS jsonb), #{userId}
        )
    </select>

    <!--
      삭제 차단 — 전송대기(WRK·RJT)가 아닌 문서.
      target 문구는 이 화면의 3단계 용어(전송/결재완료)로 내린다.
    -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT d.doc_no AS ref_key,
               CASE d.status WHEN 'REQ' THEN '전송' WHEN 'REV' THEN '전송'
                             WHEN 'APV' THEN '결재완료' ELSE d.status END AS target
          FROM tbl_document d
          JOIN tbl_ccp_generic_monitor m ON m.doc_idx = d.idx AND m.co_cd = d.co_cd
         WHERE d.co_cd = #{coCd} AND d.del_yn = 'N'
           AND d.status NOT IN ('WRK', 'RJT') AND d.idx IN
           <foreach collection="docIdxs" item="id" open="(" separator="," close=")">#{id}</foreach>
         ORDER BY d.doc_no LIMIT 1
    </select>

    <!-- 삭제 — 기록행·셀·문서 허브 -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_tbl_ccp_generic_monitor_d_000(
            #{coCd, jdbcType=VARCHAR},
            #{docIdx, jdbcType=BIGINT},
            #{userId, jdbcType=VARCHAR}
        )
    </update>
</mapper>
