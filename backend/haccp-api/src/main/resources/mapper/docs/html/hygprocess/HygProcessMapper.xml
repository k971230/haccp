<?xml version="1.0" encoding="UTF-8"?>
<!--
HygProcessMapper.xml — 일반위생·공정점검 작성 SP.

개발자: 박승우
일자: 2026-08-19
코멘트:
  1) tmpl_cd html_sys_001 고정. 신규 상세는 적용 버전 항목
  2) 삭제 차단은 foreach IN 단일 쿼리
  3) 저장 payload는 jsonb. 저장 직후 sign_u_000이 서명 스냅샷

PIPELINE[HB131] 공정점검 XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.docs.html.hygprocess.HygProcessMapper">

    <!-- 좌측 문서 목록 — 기준일·문서번호·작성자. tmplCd 는 이 화면 고정 html_sys_001 (121에서 양식별로 열림) -->
    <select id="selectList" resultType="com.haccp.docs.html.hygprocess.dto.HygProcessListRow">
        SELECT * FROM sp_tbl_hyg_process_r_000(
            #{coCd}, #{tmplCd}, #{fromDt}, #{toDt}, #{docNo}, #{writer},
            <!-- 양식명·작성자ID·작성자명은 이 화면 검색조건이 아니다. 122 인자에 빈값을 넘긴다 -->
            '', '', ''
        )
    </select>

    <!-- 상세/신규 기본행 — JSON 문자열. 신규 항목은 tmplCd 계열이 정한다 -->
    <select id="selectDetail" resultType="string">
        SELECT sp_tbl_hyg_process_r_001(#{coCd}, #{tmplCd}, #{docIdx})::text
    </select>

    <!-- 저장 — 문서·헤더·항목 전체 교체. 신규는 SP 가 사용여부 Y 와 채번 규칙을 확인한다 -->
    <select id="save" resultType="long">
        SELECT sp_tbl_hyg_process_c_000(
            #{coCd}, #{tmplCd}, #{docIdx}, #{baseDt}, #{checkerNm},
            CAST(#{payload} AS jsonb), #{userId}
        )
    </select>

    <!-- 점검자·승인자·확인 서명 스냅샷 — 이름 매칭. 저장 직후 -->
    <update id="snapshotSigns" statementType="CALLABLE">
        CALL sp_tbl_hyg_process_sign_u_000(
            #{coCd, jdbcType=VARCHAR},
            #{docIdx, jdbcType=BIGINT},
            #{checkerNm, jdbcType=VARCHAR},
            #{approverNm, jdbcType=VARCHAR},
            #{confirmNm, jdbcType=VARCHAR}
        )
    </update>

    <!-- 삭제 차단 — 결재 진행·완료 -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT d.doc_no AS ref_key,
               CASE d.status WHEN 'REQ' THEN '결재요청' WHEN 'REV' THEN '결재검토'
                             WHEN 'APV' THEN '결재완료' ELSE d.status END AS target
          FROM tbl_document d
         WHERE d.co_cd = #{coCd} AND d.tmpl_cd = #{tmplCd} AND d.del_yn = 'N'
           AND d.status NOT IN ('WRK', 'RJT') AND d.idx IN
           <foreach collection="docIdxs" item="id" open="(" separator="," close=")">#{id}</foreach>
         ORDER BY d.doc_no LIMIT 1
    </select>

    <!-- 삭제 — 하위·문서 허브 -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_tbl_hyg_process_d_000(
            #{coCd, jdbcType=VARCHAR},
            #{docIdx, jdbcType=BIGINT},
            #{userId, jdbcType=VARCHAR}
        )
    </update>
</mapper>
