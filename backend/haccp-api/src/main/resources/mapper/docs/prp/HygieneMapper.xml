<?xml version="1.0" encoding="UTF-8"?>
<!--
HygieneMapper.xml — 위생 DB형 5종 공통 SP 호출.
개발자: 박승우
일자: 2026-08-06
코멘트:
  1) 목록·상세·저장은 양식코드를 SP에 전달하고 테넌트는 JWT coCd로 고정한다
  2) 삭제 차단은 foreach IN 단일 쿼리이며 임시·반려 이외 상태를 막는다
  3) 동적 JSON은 PostgreSQL jsonb로 캐스팅하여 양식별 정규화 테이블에 저장한다
PIPELINE[HB85] 위생 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.docs.prp.HygieneMapper">
    <!-- 목록 — 기준일 범위와 양식코드 -->
    <select id="selectList" resultType="com.haccp.docs.prp.dto.HygieneListRow">
        SELECT * FROM sp_tbl_hygiene_document_r_000(#{coCd}, #{tmplCd}, #{fromDt}, #{toDt}, #{docNo}, #{writer})
    </select>
    <!-- 상세/신규 기본행 — JSON 문자열 -->
    <select id="selectDetail" resultType="string">
        SELECT sp_tbl_hygiene_document_r_001(#{coCd}, #{tmplCd}, #{docIdx})
    </select>
    <!-- 저장 — 양식별 entries·signers·checkers JSON 전체 교체 -->
    <select id="save" resultType="long">
        SELECT sp_tbl_hygiene_document_c_000(
            #{coCd}, #{tmplCd}, #{docIdx}, #{baseDt}, #{baseDtTo}, #{checkerNm},
            CAST(#{payload} AS jsonb), #{userId}
        )
    </select>
    <!-- 삭제 차단 — 결재 진행·완료 문서의 첫 항목만 반환 -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT d.doc_no AS ref_key,
               CASE d.status WHEN 'REQ' THEN '결재요청' WHEN 'REV' THEN '결재검토'
                             WHEN 'APV' THEN '결재완료' ELSE d.status END AS target
          FROM tbl_document d
         WHERE d.co_cd = #{coCd} AND d.tmpl_cd = #{tmplCd} AND d.del_yn = 'N'
           AND d.status NOT IN ('TMP', 'RJT') AND d.idx IN
           <foreach collection="docIdxs" item="id" open="(" separator="," close=")">#{id}</foreach>
         ORDER BY d.doc_no LIMIT 1
    </select>
    <!-- 삭제 — SP가 양식별 하위 테이블과 문서 허브 행을 함께 제거 -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_tbl_hygiene_document_d_000(#{coCd}, #{tmplCd}, #{docIdx}, #{userId})
    </update>
</mapper>
