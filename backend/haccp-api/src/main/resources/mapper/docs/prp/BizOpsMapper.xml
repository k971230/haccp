<?xml version="1.0" encoding="UTF-8"?>
<!--
역할 — 시설·재고·공정 DB형 양식 6종의 PG 저장프로시저 호출

개발자: 박승우
일자: 2026-08-06
코멘트:
  1) 목록·상세·저장은 sp_tbl_biz_ops_* 함수로 호출하고 삭제는 PROCEDURE로 호출한다
  2) templateCode는 URL을 해석한 Controller의 고정값으로만 전달되어 임의 테이블 접근이 불가능하다
  3) 삭제 차단은 결재 상태를 foreach IN 단일 쿼리로 검사해 Double Check를 지원한다

PIPELINE[HB89] 시설·재고·공정 MyBatis XML
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haccp.docs.prp.BizOpsMapper">
    <!-- 목록 — 기준일 구간의 문서번호·상태·행수 -->
    <select id="selectList" resultType="map">
        SELECT * FROM sp_tbl_biz_ops_r_000(#{coCd}, #{tmplCd}, #{fromDt}, #{toDt}, #{docNo}, #{writer})
    </select>

    <!-- 상세 — header와 rows를 camelCase JSON으로 반환 -->
    <select id="selectDetail" resultType="string">
        SELECT sp_tbl_biz_ops_r_001(#{coCd}, #{tmplCd}, #{docIdx})
    </select>

    <!-- 저장 — 양식별 payload JSON은 DB 컬럼으로 정규화된다 -->
    <select id="save" resultType="long">
        SELECT sp_tbl_biz_ops_c_000(
            #{coCd}, #{tmplCd}, #{docIdx},
            CAST(#{payloadJson, jdbcType=VARCHAR} AS jsonb), #{userId}
        )
    </select>

    <!-- 삭제 차단 — 임시·반려 외 결재 상태가 있으면 첫 문서를 반환 -->
    <select id="selectDeleteBlocker" resultType="com.haccp.common.validation.DeleteBlocker">
        SELECT d.doc_no AS ref_key,
               CASE d.status WHEN 'REQ' THEN '결재요청' WHEN 'REV' THEN '결재검토'
                             WHEN 'APV' THEN '결재완료' ELSE d.status END AS target
          FROM tbl_document d
         WHERE d.co_cd = #{coCd} AND d.tmpl_cd = #{tmplCd} AND d.del_yn = 'N'
           AND d.status NOT IN ('TMP', 'RJT') AND d.idx IN
        <foreach collection="docIdxs" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
         ORDER BY d.doc_no
         LIMIT 1
    </select>

    <!-- 삭제 — SP가 문서·하위행·자동 수불내역을 한 트랜잭션에서 정리 -->
    <update id="delete" statementType="CALLABLE">
        CALL sp_tbl_biz_ops_d_000(#{coCd}, #{tmplCd}, #{docIdx}, #{userId})
    </update>
</mapper>
