# ============================================================
#  haccp-api 환경변수 예제 (.env.example) — 이 파일만 git에 올린다
#
#  개발자: 박승우
#  일자: 2026-08-05
#  코멘트:
#    1) 실제 값은 .env 로 복사해 채운다. .env 는 절대 커밋하지 않는다
#    2) DB는 mes-api(metis)와 다른 sasshaccp 를 쓴다 — 두 API가 같은 DB를 공유하지 않는다
#    3) JWT_SECRET 은 HS512라 64바이트 이상이어야 한다. 짧으면 기동 자체가 실패한다
# ============================================================

# --- 서버 ---
# 로컬·Docker 동일 7070 (운영 컨테이너 listen 과 맞춤). mes-api(8080) 과 충돌 없음
SERVER_PORT=7070

# --- DB (외부 PostgreSQL) ---
DB_DRIVER=org.postgresql.Driver
# currentSchema=sasshaccp 는 SP 본문의 스키마 없는 테이블 참조를 해석하기 위한 것이다
DB_URL=jdbc:postgresql://DB_HOST:5432/sasshaccp?currentSchema=sasshaccp&escapeSyntaxCallMode=callIfNoReturn
DB_HOST=changeme
DB_PORT=5432
DB_NAME=sasshaccp
DB_USERNAME=changeme
DB_PASSWORD=changeme

# --- 커넥션 풀 ---
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_CONNECTION_TIMEOUT=30000

# --- OPS_TIMEOUT_DEFENSE (초) ---
TX_DEFAULT_TIMEOUT_SECONDS=60
MYBATIS_STATEMENT_TIMEOUT_SECONDS=60

# --- JWT ---
# openssl rand -hex 48 등으로 생성한 64바이트 이상 문자열
JWT_SECRET=changeme-64-bytes-or-longer
# 8시간 근무 1교대 기준
JWT_EXPIRE_MINUTES=480

# --- 로그인 잠금 ---
# 연속 실패 임계. 0 이하로 두면 잠금 기능을 쓰지 않는다
LOGIN_MAX_FAIL_COUNT=5

# --- 배치 스케줄 (Spring cron 6필드, timezone=APP_TIMEZONE) ---
# 배치·집계 기준 타임존
APP_TIMEZONE=Asia/Seoul
# 작성 과제 일일 생성 — 기본 매일 00:05
TASK_GENERATION_CRON=0 5 0 * * *
# 문서주기 마감 알림 — 몇 분 전(기본 60)
SCHEDULE_ALARM_BEFORE_MINUTES=60
# 문서주기 예정일을 몇 개월치 미리 만들지(기본 12)
SCHEDULE_GENERATE_MONTHS=12
# 마감 임박 알림 점검 — 기본 10분 간격
SCHEDULE_ALARM_CRON=0 */10 * * * *
# 화면 UV/PV 일자 집계 — 기본 매일 00:15(과제 생성 직후). 전일·당일 tbl_view_stat_daily 업서트
VIEW_STAT_DAILY_CRON=0 15 0 * * *
# true면 기동 직후 전일·당일 1회 집계(로컬 스모크용). 운영은 false
VIEW_STAT_DAILY_RUN_ON_STARTUP=false

# --- CORS ---
# haccp-web Vite 개발 서버 Origin (vite.config.ts server.port=4173)
CORS_ALLOWED_ORIGINS=http://localhost:4173

# --- 화면 권한 서버 검사 ---
# true: write_yn/delete_yn=N 이면 API 403. false: 로그만(운영 1일 shadow 후 true)
# 실사용 배포 전에는 true 이어야 한다
SCREEN_AUTH_ENFORCE=true

# --- 문서 파일 볼륨 ---
# HWPX·PDF·사진·일반첨부를 저장하는 서버 경로. 상대 경로면 haccp-api 모듈 디렉터리 기준(실행 CWD 아님)
# 로컬 Windows 예: D:/haccp/backend/haccp-api/data/haccp-files
# 운영 Docker: /var/haccp/files
APP_FILE_ROOT=./data/haccp-files
# 작성 문서·첨부 루트 — HaccpLogBooks/{회사코드}/{일자}/{양식코드}/{uuid}_{파일명}
APP_DOCUMENT_LOGBOOK_DIRECTORY=HaccpLogBooks
# 파일 1건 최대 크기 — byte 값과 Spring multipart 문자열을 같은 한도로 맞춘다
APP_FILE_MAX_BYTES=20971520
APP_FILE_MAX_SIZE=20MB
APP_FILE_MAX_REQUEST_SIZE=25MB

# --- 표준 HWP 템플릿 초기화 (볼륨 — 바이너리는 DB에 넣지 않음) ---
# 전 회사 공통 표준 양식 루트 — HaccpTemplates/{양식코드}/{파일명}
APP_TEMPLATE_STANDARD_DIRECTORY=HaccpTemplates
# 회사별 자사 커스텀 양식 루트 — CustomTemplates/{회사코드}/{양식코드}/{파일명}
APP_TEMPLATE_CUSTOM_DIRECTORY=CustomTemplates
# 매니페스트 TSV — 양식 추가 시 이 파일만 수정 (Java 하드코딩 금지)
APP_TEMPLATE_MANIFEST=templates/manifest.tsv
# docs/배포 원본 루트. 비우면 기동 시 초기화 스킵. 로컬 예: D:/SassHaccp/docs
# form 400 시 APP_FILE_ROOT/HaccpTemplates/{양식코드}/{파일명} 또는 CustomTemplates/{회사코드}/ 확인
APP_TEMPLATE_IMPORT_ROOT=
# true면 기존 템플릿 파일을 교체한다. 기본 false는 운영 원본 보존
APP_TEMPLATE_IMPORT_OVERWRITE=false

# --- rhwp CLI PDF 내보내기 ---
# Windows: ../../tools/rhwp/rhwp/rhwp.exe  /  Linux 컨테이너: /opt/rhwp/rhwp
APP_RHWP_CLI_PATH=
# CLI 대기 초 — VITE_API_TIMEOUT_FILE(120s)·Nginx 70s Grace보다 짧게
APP_RHWP_TIMEOUT_SECONDS=110
# Nanum 등 폰트 디렉터리. Linux는 fonts-nanum 패키지 또는 볼륨 마운트 경로
APP_RHWP_FONT_PATH=
APP_RHWP_FALLBACK_SERIF=NanumGothic
APP_RHWP_FALLBACK_SANS=NanumGothic
APP_RHWP_FALLBACK_MONO=
# CLI 임시 작업 폴더. 비우면 java.io.tmpdir/haccp-rhwp
APP_RHWP_WORK_DIR=

# --- 로그 ---
LOG_LEVEL=INFO
