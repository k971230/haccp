# ============================================================
#  haccp edge 라우팅 — 평문 7070 · Apache Path 분기 백엔드
#
#  개발자: 박승우
#  일자: 2026-08-11
#  코멘트:
#    1) TLS는 호스트 Apache(443)가 종단한다 — edge 는 루프백 평문만 받는다
#    2) 호스트 바인딩은 127.0.0.1:17070:7070 단권 — 공인 8080/8443 는 CLOSE
#    3) ${HACCP_*} 는 기동 시 envsubst — $host 등은 NGINX_ENVSUBST_FILTER 로 보존
#
#  치환 변수: HACCP_SERVER_NAME · HACCP_ACTUATOR_ALLOW · HACCP_RESOLVER
# ============================================================

# 도커 사용자 정의 네트워크 내장 DNS — 업스트림 IP 가 바뀌어도 요청마다 다시 푼다
resolver ${HACCP_RESOLVER} valid=30s ipv6=off;

# Apache 가 넘긴 X-Forwarded-Proto 를 우선한다. 없으면 edge 자신의 scheme(http)
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# ------------------------------------------------------------
# 평문 7070 — 호스트 127.0.0.1:17070 과 매핑. 실제 서비스 라우팅 전부
# ------------------------------------------------------------
server {
    # nginx-unprivileged 는 uid 101 이라 1024 미만 포트를 열 수 없다
    listen      7070;
    server_name ${HACCP_SERVER_NAME};

    # 백엔드 multipart 한도(APP_FILE_MAX_REQUEST_SIZE=25MB)보다 크게 잡아
    # 크기 초과 판정과 사용자 문구를 백엔드가 내도록 한다
    client_max_body_size 30M;

    # --------------------------------------------------------
    # 공통 프록시 — location 에서 proxy_set_header 를 다시 쓰면 그 블록은 상속이 끊긴다
    # --------------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    # TLS 종단이 Apache 이므로 클라이언트 scheme 을 그대로 백엔드에 전달한다
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # OPS_TIMEOUT_DEFENSE — 백엔드 트랜잭션 60s 에 10s Grace
    proxy_connect_timeout 10s;
    proxy_send_timeout    70s;
    proxy_read_timeout    70s;

    # 컨테이너 HEALTHCHECK · Apache /haccp/healthz(프리픽스 제거 후) 공용
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --------------------------------------------------------
    # 파일 업로드·다운로드·PDF — 기본 70s 로는 끊긴다 (130s)
    # --------------------------------------------------------
    #
    # 2026-08-26 — 경로를 지금 URL 로 맞췄다. 옛 경로(doc/·bas/·hyg/)를 그대로 두면
    # 그 요청이 이 블록에 안 걸려 기본 70s 로 처리된다 — 큰 HWP 업로드가 끊긴다.
    # 여기 목록은 backend 컨트롤러의 multipart·download·pdf 매핑과 같아야 한다.
    location ~ ^/api/v1/(docs/documents/[^/]+/(files|export-pdf)|docs/documents/files/[^/]+/download|docs/templates/[^/]+/form|docs/audit-export/preview-pdf|sys/users/(me|[^/]+)/sign)$ {
        # 컨테이너 내부 api listen 7070 — 호스트 publish 없음
        set $haccp_api_file http://api:7070;
        proxy_pass $haccp_api_file$request_uri;

        proxy_send_timeout 130s;
        proxy_read_timeout 130s;
    }

    # --------------------------------------------------------
    # 일반 API — 브라우저는 상대경로 /api/... (Apache /api/ → edge)
    # --------------------------------------------------------
    location /api/ {
        set $haccp_api http://api:7070;
        proxy_pass $haccp_api$request_uri;
    }

    # --------------------------------------------------------
    # Actuator — 기본 루프백 허용만 (운영망 CIDR 은 HACCP_ACTUATOR_ALLOW)
    # --------------------------------------------------------
    location /actuator/ {
        allow ${HACCP_ACTUATOR_ALLOW};
        deny  all;

        set $haccp_actuator http://api:7070;
        proxy_pass $haccp_actuator$request_uri;
    }

    # --------------------------------------------------------
    # rhwp 스튜디오 — 동일출처 iframe (Apache /rhwp/ 도 edge 로 프록시)
    # --------------------------------------------------------
    location /rhwp/ {
        set $rhwp_studio https://edwardkim.github.io;
        proxy_pass $rhwp_studio$request_uri;

        proxy_set_header Host   edwardkim.github.io;
        proxy_ssl_server_name   on;
        proxy_ssl_name          edwardkim.github.io;
        proxy_redirect off;
    }

    # --------------------------------------------------------
    # 그 외 전부 — 정적 SPA (컨테이너 내부 web:7070)
    # --------------------------------------------------------
    location / {
        set $haccp_web http://web:7070;
        proxy_pass $haccp_web$request_uri;
    }
}
