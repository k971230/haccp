# ============================================================
#  haccp edge 라우팅 — TLS 종단 · 동일출처 프록시
#
#  개발자: 박승우
#  일자: 2026-08-10
#  코멘트:
#    1) 한 출처(origin)로 정적·API·rhwp 를 합쳐 CORS 없이 동작하게 한다
#    2) ${HACCP_*} 는 컨테이너 기동 시 envsubst 가 채운다 — 도메인·인증서를 이미지에 굽지 않기 위해서다
#    3) $host·$remote_addr 등 nginx 변수는 NGINX_ENVSUBST_FILTER 덕에 치환되지 않고 그대로 남는다
#
#  치환 변수: HACCP_SERVER_NAME · HACCP_CERT_DIR · HACCP_ACTUATOR_ALLOW · HACCP_RESOLVER
# ============================================================

# 도커 사용자 정의 네트워크의 내장 DNS 주소(127.0.0.11 고정).
# 업스트림을 리터럴로 적으면 nginx 가 기동 시점에 IP 를 한 번만 박아
# api 컨테이너가 재기동해 IP 가 바뀌면 계속 502 를 낸다. 변수 + resolver 는 요청마다 다시 푼다
resolver ${HACCP_RESOLVER} valid=30s ipv6=off;

# ------------------------------------------------------------
# 평문 8080 — 호스트 80 과 매핑. 인증서 갱신과 헬스체크만 남기고 전부 HTTPS 로 보낸다
# ------------------------------------------------------------
server {
    # nginx-unprivileged 는 uid 101 로 돌아 1024 미만 포트를 열 수 없다
    listen      8080;
    server_name _;

    # 컨테이너 HEALTHCHECK 전용 — exact match 라 아래 301 보다 우선한다.
    # 이게 없으면 헬스체크가 리다이렉트를 받아 컨테이너가 unhealthy 로 떨어진다
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # certbot http-01 챌린지 — edge 를 내리지 않고 인증서를 갱신하기 위한 통로다.
    # ^~ 라 아래 정규식·프리픽스보다 먼저 잡힌다
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 나머지는 전부 HTTPS 로 — $host 에는 포트가 붙지 않아 외부 표준 443 으로 간다
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------
# TLS 8443 — 호스트 443 과 매핑. 실제 서비스 라우팅은 전부 여기에 있다
# ------------------------------------------------------------
server {
    listen      8443 ssl;
    # 1.25.1 부터 listen 의 http2 파라미터가 폐기돼 별도 지시어로 켠다
    http2       on;
    server_name ${HACCP_SERVER_NAME};

    # 인증서는 이미지에 없다 — /etc/letsencrypt 를 읽기 전용으로 마운트해서 넣는다.
    # 파일이 없으면 nginx 가 기동조차 못 하므로 배포 전 certbot 또는 gen_selfsigned.sh 가 선행돼야 한다
    ssl_certificate     ${HACCP_CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${HACCP_CERT_DIR}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    # 최신 클라이언트의 암호군 선호를 존중한다 (서버 강제는 오히려 구식 조합을 남긴다)
    ssl_prefer_server_ciphers off;

    # 2년 — always 를 붙여야 4xx·5xx 응답에도 헤더가 실린다
    add_header Strict-Transport-Security "max-age=63072000" always;

    # 백엔드 multipart 한도(APP_FILE_MAX_REQUEST_SIZE=25MB)보다 크게 잡아
    # 크기 초과 판정과 사용자 문구를 백엔드가 내도록 한다
    client_max_body_size 30M;

    # --------------------------------------------------------
    # 공통 프록시 설정 — server 에 한 번만 선언하면 아래 location 들이 상속받는다.
    # 단 location 에서 proxy_set_header 를 하나라도 다시 쓰면 그 location 은 전부 대체된다(/rhwp)
    # --------------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # OPS_TIMEOUT_DEFENSE — 백엔드 트랜잭션 60s 에 10s Grace 를 더한 값이 기본이다
    proxy_connect_timeout 10s;
    proxy_send_timeout    70s;
    proxy_read_timeout    70s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --------------------------------------------------------
    # 파일 업로드·다운로드·PDF 변환 — 기본 70s 로는 끊긴다.
    # rhwp CLI 대기(APP_RHWP_TIMEOUT_SECONDS=110)와 FE httpFile(120s) 둘 다보다 커야 해서 130s 다.
    # 정규식 location 은 프리픽스(/api/)보다 먼저 판정되므로 순서와 무관하게 이 블록이 이긴다
    # --------------------------------------------------------
    location ~ ^/api/v1/(doc/documents/[^/]+/(files|export-pdf)|doc/documents/files/[^/]+/download|doc/templates/[^/]+/form|doc/audit-export/preview-pdf|sys/users/[^/]+/sign|hyg/health-cert/[^/]+/file|bas/equipment/[^/]+/photo|bas/company-templates/create-custom)$ {
        set $haccp_api_file http://api:8081;
        proxy_pass $haccp_api_file$request_uri;

        proxy_send_timeout 130s;
        proxy_read_timeout 130s;
    }

    # --------------------------------------------------------
    # 일반 API — 브라우저는 baseURL 없이 상대경로 /api/... 로 호출한다
    # --------------------------------------------------------
    location /api/ {
        set $haccp_api http://api:8081;
        proxy_pass $haccp_api$request_uri;
    }

    # --------------------------------------------------------
    # Actuator — 기본은 루프백만 허용해 사실상 외부 차단이다.
    # 사설망 대역을 통째로 열면 도커 브리지(172.16/12)를 타고 들어온 외부 요청까지 통과하므로
    # 운영망 CIDR 하나만 HACCP_ACTUATOR_ALLOW 로 주입해서 쓴다.
    # 컨테이너 자체 헬스체크는 내부 localhost 라 이 규칙과 무관하다
    # --------------------------------------------------------
    location /actuator/ {
        allow ${HACCP_ACTUATOR_ALLOW};
        deny  all;

        set $haccp_actuator http://api:8081;
        proxy_pass $haccp_actuator$request_uri;
    }

    # --------------------------------------------------------
    # rhwp 스튜디오 — 동일출처여야 iframe contentDocument 로 도구상자를 접을 수 있다.
    # vite.config.ts 의 개발 프록시와 같은 대상을 운영에서도 그대로 유지한다
    # --------------------------------------------------------
    location /rhwp/ {
        set $rhwp_studio https://edwardkim.github.io;
        proxy_pass $rhwp_studio$request_uri;

        # GitHub Pages 는 SNI·Host 가 자기 도메인이어야 응답한다.
        # 여기서 헤더를 다시 쓰는 순간 위 server 의 X-Forwarded-* 상속은 끊기지만,
        # 외부 정적 호스팅이라 원 클라이언트 IP 를 넘길 이유가 없다
        proxy_set_header Host   edwardkim.github.io;
        proxy_ssl_server_name   on;
        proxy_ssl_name          edwardkim.github.io;

        # 업스트림이 우리 도메인을 모르므로 리다이렉트 재작성은 끈다
        proxy_redirect off;
    }

    # --------------------------------------------------------
    # 그 외 전부 — 정적 SPA 컨테이너
    # --------------------------------------------------------
    location / {
        set $haccp_web http://web:8080;
        proxy_pass $haccp_web$request_uri;
    }
}
