# ============================================================
#  docker compose 운영 환경변수 예제 — 이 파일만 git에 올린다
#
#  개발자: 박승우
#  일자: 2026-08-10
#  코멘트:
#    1) .env.docker 로 복사해 실제 값을 채운다. .env.docker 는 절대 커밋하지 않는다
#    2) 이 파일 하나가 두 가지 통로로 쓰인다 —
#       (a) --env-file 로 읽혀 compose 의 ${...} 치환에 쓰이고
#       (b) api 서비스의 env_file 로 읽혀 컨테이너 환경변수가 된다
#    3) 앱 키의 정본은 backend/haccp-api/.env.example 이다. 값 의미가 헷갈리면 그쪽을 본다
#
#  사용:
#    cp .env.docker.example .env.docker
#    docker compose --env-file .env.docker -f docker-compose.prod.yml up -d
# ============================================================

# --- 이미지 (compose 치환 전용) ---
# GHCR 네임스페이스. 로컬 검증 시에도 이 접두어로 태그를 달아 두면 그대로 쓸 수 있다
REGISTRY=ghcr.io/k971230
TAG=latest

# --- DB 접속 ---
# 기본: Ubuntu 호스트에 깐 PostgreSQL — api 컨테이너에서는 host.docker.internal
# (compose 의 extra_hosts: host.docker.internal:host-gateway 가 필요)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=sasshaccp
DB_URL=jdbc:postgresql://${DB_HOST}:5432/${DB_NAME}?currentSchema=sasshaccp&escapeSyntaxCallMode=callIfNoReturn
# 내부 PG(--profile with-db)를 쓸 때만:
# DB_HOST=db
# DB_URL=jdbc:postgresql://db:5432/sasshaccp?currentSchema=sasshaccp&escapeSyntaxCallMode=callIfNoReturn
DB_USERNAME=changeme
DB_PASSWORD=changeme

# --- 시크릿 ---
# HS512라 64바이트 이상이어야 한다. 짧으면 기동 자체가 실패한다 (openssl rand -hex 48)
JWT_SECRET=changeme-64-bytes-or-longer-0000000000000000000000000000000000

# --- edge (도메인·TLS·actuator) ---
# 인증서 파일명과 server_name 이 이 값에서 함께 조립된다
HACCP_SERVER_NAME=haccp.example.com
# 컨테이너 안에서 인증서를 찾을 경로 — certbot 표준 배치를 따른다
HACCP_CERT_DIR=/etc/letsencrypt/live/haccp.example.com
# 호스트의 인증서 루트. 로컬 검증은 self-signed 를 만들어 둔 ./certs 를 가리킨다
HACCP_CERT_HOST_DIR=/etc/letsencrypt
# /actuator 를 허용할 대역 하나(CIDR 또는 IP). 기본 루프백 = 사실상 외부 차단
HACCP_ACTUATOR_ALLOW=127.0.0.1

# --- 앱 ---
# 브라우저 Origin 과 스킴·호스트가 정확히 일치해야 한다.
# Apache Path 분기 후 비표준 포트(:8080·:8443) origin 은 쓰지 않는다.
# 콤마로 여러 개를 넣을 수 있다. 값이 비면 설정 로딩이 실패한다
CORS_ALLOWED_ORIGINS=https://haccp.example.com,http://haccp.example.com
# 볼륨(haccp-rhwp)으로 주입되는 rhwp CLI 위치 — scripts/install_rhwp.sh 가 여기에 설치한다
APP_RHWP_CLI_PATH=/opt/rhwp/rhwp
# 이미지에 설치된 나눔 폰트 경로 — 비우면 PDF 한글이 깨진다
APP_RHWP_FONT_PATH=/usr/share/fonts/truetype/nanum
LOG_LEVEL=INFO

# APP_FILE_ROOT · APP_TEMPLATE_IMPORT_ROOT · TZ 는 볼륨 경로와 짝이라
# docker-compose.prod.yml 의 environment 에 고정돼 있다. 여기에 적어도 덮이지 않는다.

# --- 초기화 스크립트 전용 (컨테이너와 무관) ---
# 표준 양식 원본 HWP 디렉터리. scripts/init_volumes.sh 가 매니페스트대로 볼륨에 복사한다.
# 운영 서버에서는 원본을 올린 실제 경로로 바꾼다
HACCP_TEMPLATE_SRC=./docs
# scripts/install_rhwp.sh 가 받아올 rhwp CLI 버전
RHWP_VERSION=v0.8.2
