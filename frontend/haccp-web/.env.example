# 프론트엔드 환경변수 — DB 접속정보는 절대 포함 금지 (API 주소·화면 상수만)
# 값 변경 후 Vite dev 서버 재시작 필수

# API 베이스 URL — 로컬 haccp-api 7070 (운영 컨테이너 listen 과 동일)
VITE_API_BASE_URL=http://localhost:7070

# [OPS_TIMEOUT_TIER] API 타임아웃 (ms)
VITE_API_TIMEOUT_DEFAULT=10000
VITE_API_TIMEOUT_BATCH=60000
VITE_API_TIMEOUT_FILE=120000
# rhwp-studio URL — 비우면 동일출처 /rhwp/ (vite·nginx 프록시). CDN 직접 지정 시 도구상자 접기 불가
# VITE_RHWP_STUDIO_URL=

# [OPS_GLOBAL_CONFIG] 전역 상수
# PAGE_SIZE: 클라이언트 페이징 미사용(예약). 대량은 VIRTUAL_THRESHOLD 가상 스크롤 (G-23)
VITE_GRID_DEFAULT_PAGE_SIZE=50
VITE_GRID_VIRTUAL_THRESHOLD=100
VITE_SEARCH_DEBOUNCE_MS=300
VITE_API_RETRY_COUNT=2
VITE_DASHBOARD_POLLING_MS=10000

# 화면 조회 로그 전송 주기 (ms)
VITE_VIEW_LOG_FLUSH_MS=30000

# 토스트 표시 시간 (ms) — 일반 / 오류
VITE_TOAST_DURATION_MS=2600
VITE_TOAST_ERROR_DURATION_MS=5000
