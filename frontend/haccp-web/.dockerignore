# ============================================================
#  haccp-web 빌드 컨텍스트 제외 목록
#
#  개발자: 박승우
#  일자: 2026-08-10
#  코멘트:
#    1) 컨텍스트가 frontend/haccp-web 이라 루트 .dockerignore 는 적용되지 않는다
#    2) node_modules 는 이미지 안에서 npm ci 로 다시 설치한다 (플랫폼 바이너리 불일치 방지)
#    3) .env 계열은 이미지에 들어가면 안 된다 — 빌드 값은 --build-arg 로만 주입한다
# ============================================================

# 호스트 설치본 — Windows 바이너리가 리눅스 이미지에 섞이는 것을 막는다
node_modules
.vite

# 빌드 산출물 — 이미지 안에서 다시 만든다
dist
coverage

# 시크릿
.env
.env.*
!.env.example

.git
.gitignore
*.log
