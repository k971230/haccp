# Playwright E2E (G-21) — 이 파일을 복사해 e2e/.env 로 쓰거나 셸 export
# 값은 git 에 커밋하지 않는다 (.gitignore: .env*)

# FE origin + Vite base path (운영 Apache Path 예)
# trailing slash 권장 — playwright baseURL 해석
E2E_BASE_URL=https://180.71.58.87/haccp/
# self-signed 이면 1
E2E_INSECURE=1

# 테스트 계정 — 상신까지: Jenkins Credential haccp-write-user (Username=DEMO 로그인 ID)
# 목록만: SMOKE_* / haccp-smoke-user 도 가능 (2번째 테스트는 skip)
E2E_USER=
E2E_PASS=

# 로컬 Vite 자동 기동 (API는 별도). 원격 URL 테스트 시 생략
# E2E_WEB_SERVER=1
