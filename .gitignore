# ── Secrets (NEVER commit) ─────────────────────────────
.env
*.env
!*.env.example
!**/.env.example
.env.docker
!.env.docker.example

# ── 로컬 TLS 검증용 자체 서명 인증서 ───────────────────
/certs/

# ── 루트 docs ─────────────────────────────────────────
# 정본 md 는 docs/1_~n_ (추적). 양식 HWP 는 docs/templates/ (로컬 전용).
# FE/BE 하위 docs/ 는 스텁만 남긴다 — 본문은 루트 docs/ 로 모았다.
/docs/*
!/docs/README.md
!/docs/[0-9]*_*.md
!/docs/[0-9][0-9]*_*.md

# ── 로그·임시·빌드 산출물 ─────────────────────────────
*.log
*.tsbuildinfo
hs_err_pid*
token.txt
login_out.json
.smoke-tmp-*/

# ── Java / Spring ──────────────────────────────────────
target/
*.class
*.war
backend/haccp-api/data/

# ── Node / React ───────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── IDE / OS ───────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
