# ── Secrets (NEVER commit) ─────────────────────────────
.env
*.env
!*.env.example
!**/.env.example
.env.docker
!.env.docker.example

# ── 로컬 TLS 검증용 자체 서명 인증서 ───────────────────
/certs/

# ── 로컬 전용 도구·MCP 산출 ───────────────────────────
/.tools/
# 로컬 전용 도구 — 01-project-core.mdc (git 미포함)
# tools/ 는 로컬 전용이 원칙이다 — 아래 넷만 올린다.
# 디렉터리를 통째로 무시하면 안쪽 예외가 안 먹으므로 파일 단위로 무시한다.
/tools/*
/tools/out/
# 시험용 DB 도구 — 비밀은 없고 backend/.env 에서 접속정보를 읽는다.
# 이게 있어야 CI 도 「저장했다」가 아니라 DB 로 판정할 수 있다 (접속정보를 주면).
!/tools/q.mjs
!/tools/seed_test_db.mjs
!/tools/seed_test_forms.sql
!/tools/reset_test_documents.sql
/.playwright-mcp/

# ── 루트 docs ─────────────────────────────────────────
# 정본 md 는 docs/1_~n_ (추적). 시스템·사용자 시드 HWP 는 templates/new · templates/usr.
/docs/*
!/docs/README.md
!/docs/[0-9]*_*.md
!/docs/[0-9][0-9]*_*.md
!/docs/templates/
/docs/templates/*
!/docs/templates/README.md
!/docs/templates/new/
!/docs/templates/new/**
!/docs/templates/usr/
!/docs/templates/usr/**

# ── 로그·임시·빌드 산출물 ─────────────────────────────
*.log
*.tsbuildinfo
hs_err_pid*
token.txt
login_out.json
.smoke-tmp-*/

# ── Java / Spring ──────────────────────────────────────
target/
*.class
*.war
backend/haccp-api/data/

# ── Node / React ───────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/
# 경로를 고정하지 않는다 — 어느 폴더에서 돌려도 산출물이 안 올라가게
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ── IDE / OS ───────────────────────────────────────────
.idea/
.vscode/*
# 팀 공용 설정은 올린다 — 도구가 달라도 같은 규칙이 걸리게 (10-ide-workflow)
!.vscode/settings.json
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
docker-compose.e2e-local.yml

# Cygwin/Git Bash 크래시 덤프
*.stackdump

# 실무 검증 봇 작업 폴더 — 보고서만 쌓인다. 저장소에 안 올린다
grokbot/

# 파이썬 캐시 — scripts/_sp_migration_diff.py 가 남긴다
__pycache__/
